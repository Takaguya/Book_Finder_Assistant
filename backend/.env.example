# Google Books API (server key, "API key" restricted to Books API is enough)
GOOGLE_BOOKS_API_KEY=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Firebase Admin SDK service account (path to downloaded JSON file)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=
# Alternative to the file, for hosts like Vercel: the key file's entire JSON contents.
# Takes priority over FIREBASE_SERVICE_ACCOUNT_PATH when set. Leave empty locally.
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS: comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Max prior messages pulled from Firestore to build chat context
CHAT_HISTORY_LIMIT=20

# Per-user rate limits (0 turns one off). Counters are stored in Firestore.
RATE_LIMIT_CHAT_PER_MINUTE=6
RATE_LIMIT_CHAT_PER_DAY=100
RATE_LIMIT_NEW_SESSIONS_PER_HOUR=20
RATE_LIMIT_BOOK_SEARCHES_PER_MINUTE=20

# Interactive API docs at /docs. Set to false on public deployments.
API_DOCS_ENABLED=true
