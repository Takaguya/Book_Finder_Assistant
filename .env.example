# Used by docker-compose.yml at build time (Vite bakes these into the frontend bundle)
# and to configure CORS on the backend. Copy to ".env" and fill in.
# Runtime backend secrets (GEMINI_API_KEY, GOOGLE_BOOKS_API_KEY, etc.) still live in backend/.env
# — docker-compose loads that file directly via env_file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:8080
